---
import PageLayout from '~/layouts/PageLayout.astro';
import Header from '~/components/widgets/Header.astro';

import { getHeaderData } from '~/navigation';
import { getLocaleFromPathname } from '~/i18n/utils';
import type { MetaData } from '~/types';

export interface Props {
  metadata?: MetaData;
}

const { metadata } = Astro.props;
const locale = getLocaleFromPathname(Astro.url.pathname);
const headerData = getHeaderData(locale);
---

<PageLayout metadata={metadata}>
  <Fragment slot="announcement">
    <slot name="announcement" />
  </Fragment>
  <Fragment slot="header">
    <slot name="header">
      <Header
        locale={locale}
        links={headerData?.links[2] ? [headerData.links[2]] : undefined}
        actions={[
          {
            text: locale === 'es' ? 'Descargar' : 'Download',
            href: 'https://github.com/arthelokyo/astrowind',
          },
        ]}
        showToggleTheme
        showLanguageSwitcher
        position="right"
      />
    </slot>
  </Fragment>
  <slot />
</PageLayout>
