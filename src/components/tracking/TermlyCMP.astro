---
interface Props {
  websiteUUID?: string;
}
const websiteUUID = import.meta.env.PUBLIC_TERMLY_CMP_WEBSITE_UUID || Astro.props.websiteUUID;
---

{
  websiteUUID && (
    <script
      id="termly-cmp"
      is:inline
      src={`https://app.termly.io/resource-blocker/${websiteUUID}?autoBlock=on`}
      onload="window.dispatchEvent(new Event('termly:ready'))"
    />
  )
}
<script>
  import '../../scripts/termly';
</script>
