---
import { SITE } from 'astrowind:config';

interface Props {
  position?: 'head' | 'body';
}
const { position = 'head' } = Astro.props;
const id = import.meta.env.PUBLIC_GOOGLE_TAG_MANAGER_ID;
const enabled = import.meta.env.PROD && id && position === 'head';
const config = JSON.stringify({ id, hostname: new URL(SITE.site).hostname }).replace(/</g, '\\u003c');
---

{enabled && <script id="gtm-config" type="application/json" is:inline set:html={config} />}
<!-- A noscript iframe cannot obtain analytics consent, so there is no fallback. -->
<script>
  import '../../scripts/google-tag-manager';
</script>
