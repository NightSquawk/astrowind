---
import { SITE } from 'astrowind:config';
import type { DatadogConfig } from '~/utils/datadog-config';

interface Props {
  config?: Partial<DatadogConfig>;
}
const defaults = Astro.props.config || {};
const config = {
  applicationId: import.meta.env.PUBLIC_DATADOG_APPLICATION_ID || defaults.applicationId || '',
  clientToken: import.meta.env.PUBLIC_DATADOG_CLIENT_TOKEN || defaults.clientToken || '',
  site: import.meta.env.PUBLIC_DATADOG_SITE || defaults.site || 'us3.datadoghq.com',
  service: import.meta.env.PUBLIC_DATADOG_SERVICE || defaults.service || 'website',
  env: import.meta.env.PUBLIC_DATADOG_ENV || defaults.env || 'production',
  version: import.meta.env.PUBLIC_DATADOG_VERSION || defaults.version,
  allowedHosts: import.meta.env.PUBLIC_DATADOG_ALLOWED_HOSTS?.split(',').map((host: string) =>
    host.trim().toLowerCase()
  ) ||
    defaults.allowedHosts || [new URL(SITE.site).hostname],
};
const enabled = import.meta.env.PROD && config.applicationId && config.clientToken;
const serialized = JSON.stringify(config).replace(/</g, '\\u003c');
---

{enabled && <script id="datadog-config" type="application/json" is:inline set:html={serialized} />}
<script>
  import '../../scripts/datadog-init';
</script>
