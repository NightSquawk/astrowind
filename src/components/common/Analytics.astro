---
import { ANALYTICS, SITE } from 'astrowind:config';
const id = import.meta.env.PUBLIC_GOOGLE_ANALYTICS_ID || ANALYTICS?.vendors?.googleAnalytics?.id;
const config = JSON.stringify({ id, hostname: new URL(SITE.site).hostname }).replace(/</g, '\\u003c');
---

{
  import.meta.env.PROD && id && (
    <script id="google-analytics-config" type="application/json" is:inline set:html={config} />
  )
}
<script>
  import '../../scripts/google-analytics';
</script>
