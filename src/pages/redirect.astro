---
export const prerender = false;
import { getRedirect } from '~/data/redirects';
import { getPromoRedirect } from '~/data/promoRedirects';
import { buildRedirectDestination } from '~/utils/redirect-destination';

// Compatibility for existing /redirect?source=... links. Never wait for analytics.
const source = Astro.url.searchParams.get('source') || '';
let redirect = getRedirect(source);
try { redirect = (await getPromoRedirect(source)) || redirect; } catch { /* Static redirects remain available. */ }
const destination = buildRedirectDestination(redirect, Astro.url);
return Astro.redirect(destination?.toString() || '/', redirect?.permanent ? 308 : 307);
---
